# Variables de entorno para APLIMETODOS
# Copiar este archivo a .env y rellenar con valores reales antes de levantar Docker.

# Nombre de la base de datos en SQL Server
SQL_DATABASE=MetodosNumericosDB

# Contraseña del usuario 'sa' de SQL Server.
# Debe cumplir la politica de SQL Server: minimo 8 caracteres,
# con mayusculas, minusculas, numeros y simbolos.
SQL_PASSWORD=CambiaEstaPassword123!
